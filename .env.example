# ══════════════════════════════════════════════════════════════════
# CodeZero — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Azure OpenAI ───────────────────────────────────────────────────
# Get from: Azure Portal → OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Must match the exact deployment name in Azure OpenAI Studio (not the model name)
GPT_DEPLOYMENT=your-gpt4-deployment-name

# ── Azure AI Document Intelligence ────────────────────────────────
# Used for extracting text from medical guideline PDFs (optional)
DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=your-doc-intel-key

# ── Azure AI Search ───────────────────────────────────────────────
# Used for RAG — semantic search over medical knowledge base
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_KEY=your-search-key
SEARCH_INDEX_NAME=medical-knowledge-index

# ── Azure Speech Services ─────────────────────────────────────────
# Used for voice-to-text with automatic language detection
SPEECH_KEY=your-speech-key
SPEECH_REGION=westeurope

# ── Azure Translator ──────────────────────────────────────────────
# Used for real-time question/answer translation (100+ languages)
TRANSLATOR_KEY=your-translator-key
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATOR_REGION=global

# ── Azure Maps ────────────────────────────────────────────────────
# Used for real-time ETA with live traffic (optional — haversine fallback available)
MAPS_SUBSCRIPTION_KEY=your-maps-key

# ── Azure Content Safety ──────────────────────────────────────────
# Used for filtering harmful patient input (optional)
CONTENT_SAFETY_ENDPOINT=https://your-content-safety.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=your-content-safety-key

# ── Hospital Configuration ────────────────────────────────────────
# The hospital running this server
HOSPITAL_NAME=City General Hospital
HOSPITAL_LOCATION_LAT=48.7758
HOSPITAL_LOCATION_LON=9.1829
